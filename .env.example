# 复制为 .env 后填真实值；.env 不要提交
# 本地开发默认连本机 MySQL / Redis；生产由 docker-compose 的 env_file 注入

# MySQL（知识库 ai_kb_qa + 商品只读）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=e_commerce_db
DB_USERNAME=e_commerce_db
DB_PASSWORD=

# Redis（会话历史，变量名与 Java 后端保持一致）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# 商品内存缓存秒数
PRODUCT_CACHE_TTL=60

# 知识库缓存秒数：运营改库后最多这么久生效
KB_CACHE_TTL=60

# JWT：与 Java 服务共用同一个密钥（只校验用户令牌，不签发）
JWT_SECRET=请填写与后端一致的密钥

# 防滥用（按需调整）
AI_MAX_MESSAGE_CHARS=500
AI_MAX_CONCURRENT_CHATS=10
AI_RATE_WINDOW_SECONDS=600
AI_RATE_PER_WINDOW=20
AI_RATE_PER_DAY=100
AI_STREAM_TOTAL_TIMEOUT=55

# Java 内部数据接口（/internal/ai/**）共享密钥与网关地址
# 本地开发：与各服务 application-dev.yml 的 ai.internal.token 保持一致
# 生产：与服务器 /www/java/.env 的 AI_INTERNAL_TOKEN 保持一致（必须是随机串，不能用默认值）
# 不配置则本服务调用内部接口直接报错（fail-closed），Java 侧也会拒绝一切内部请求
AI_INTERNAL_BASE_URL=http://127.0.0.1:8080
AI_INTERNAL_TOKEN=local-dev-internal-token
